:root {
  --bg-card: #121417;
  --bg-overlay: rgba(8, 10, 13, 0.78);
  --text-main: #f5f7fa;
  --text-muted: #a0a8b0;
  --accent: #e5a93c;
  --border: rgba(255, 255, 255, 0.12);
}

.cinematic-section {
  max-width: 960px;
  margin: 2rem auto;
  padding: 0 1rem;
  color: var(--text-main);
  font-family: system-ui, -apple-system, sans-serif;
}

.cinematic-card {
  position: relative;
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 18px 40px rgba(0, 0, 0, 0.45);
}

.cinematic-video-wrap {
  position: relative;
  aspect-ratio: 16 / 9;
  background: #000;
  cursor: pointer;
}

.cinematic-video-wrap video {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* Efek letterboxing sinematik opsional */
.cinematic-card.letterbox .cinematic-video-wrap::before,
.cinematic-card.letterbox .cinematic-video-wrap::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  height: 8%;
  background: #000;
  pointer-events: none;
  z-index: 2;
}

.cinematic-card.letterbox .cinematic-video-wrap::before {
  top: 0;
}

.cinematic-card.letterbox .cinematic-video-wrap::after {
  bottom: 0;
}

.cinematic-info {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  align-items: center;
  gap: 1rem;
  padding: 1rem 1.25rem;
  border-top: 1px solid var(--border);
}

.cinematic-badge {
  display: inline-block;
  font-size: 0.75rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--accent);
  margin-bottom: 0.25rem;
}

.cinematic-title {
  margin: 0;
  font-size: 1.15rem;
}

.cinematic-meta {
  margin: 0.2rem 0 0;
  font-size: 0.875rem;
  color: var(--text-muted);
}

.cinematic-controls {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
}

.cine-btn {
  background: rgba(255, 255, 255, 0.06);
  color: var(--text-main);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 0.5rem 0.85rem;
  font-size: 0.85rem;
  cursor: pointer;
  transition: background 0.2s ease, border-color 0.2s ease;
}

.cine-btn:hover {
  background: rgba(255, 255, 255, 0.14);
  border-color: var(--accent);
}

.cine-btn.active {
  background: var(--accent);
  color: #111;
  border-color: var(--accent);
  font-weight: 600;
}

/* Modal Preview */
.cine-modal {
  position: fixed;
  inset: 0;
  background: var(--bg-overlay);
  display: none;
  align-items: center;
  justify-content: center;
  padding: 1.5rem;
  z-index: 999;
}

.cine-modal.open {
  display: flex;
}

.cine-modal-box {
  position: relative;
  width: min(100%, 960px);
  background: #0b0d10;
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 1rem;
}

.cine-modal-box video {
  width: 100%;
  max-height: 75vh;
  border-radius: 8px;
  display: block;
}

.cine-close {
  position: absolute;
  top: -0.9rem;
  right: -0.9rem;
  width: 2.2rem;
  height: 2.2rem;
  border-radius: 50%;
  border: 1px solid var(--border);
  background: #1a1d23;
  color: #fff;
  font-size: 1.1rem;
  cursor: pointer;
}
